{
  "schemaVersion": 1,
  "id": "cessna-172-sixpack",
  "name": "Cessna 172 · Classic Six-Pack",
  "icao": "C172",
  "revision": 1,
  "description": "Классическая «шестёрка» C172: скорость, авиагоризонт, высотомер, курсоуказатель, обороты и вариометр, плюс масса, авионика, табло шины и закрылки.",
  "sim": {
    "match": {
      "title": "Cessna Skyhawk*",
      "atcModel": "C172"
    }
  },
  "panel": {
    "background": "#0b1117",
    "gridSize": 8,
    "footer": "C172 · CLASSIC SIX-PACK"
  },
  "widgets": [
    {
      "id": "airspeed",
      "type": "gauge.radial",
      "label": "Скорость",
      "bindings": { "value": "speed.iasKt" },
      "options": {
        "caption": "IAS",
        "min": 0,
        "max": 200,
        "unit": "KT",
        "decimals": 0,
        "majorTicks": 8,
        "minorTicks": 4,
        "redline": 163,
        "zones": [
          { "from": 44, "to": 85, "tone": "ok" },
          { "from": 85, "to": 129, "tone": "ok" },
          { "from": 129, "to": 163, "tone": "warn" }
        ]
      },
      "layout": {
        "base": { "x": 0.02, "y": 0.05, "w": 0.21, "h": 0.3 },
        "phone": { "x": 0.02, "y": 0.02, "w": 0.45, "h": 0.16 },
        "tablet-sm": { "x": 0.02, "y": 0.04, "w": 0.2, "h": 0.28 }
      }
    },
    {
      "id": "attitude",
      "type": "attitude",
      "label": "Авиагоризонт",
      "bindings": {
        "pitch": "attitude.pitchDeg",
        "bank": "attitude.bankDeg"
      },
      "options": { "caption": "ATTITUDE" },
      "layout": {
        "base": { "x": 0.25, "y": 0.04, "w": 0.33, "h": 0.33 },
        "phone": { "x": 0.02, "y": 0.19, "w": 0.54, "h": 0.2 },
        "tablet-sm": { "x": 0.24, "y": 0.03, "w": 0.36, "h": 0.34 }
      }
    },
    {
      "id": "altimeter",
      "type": "altimeter",
      "label": "Высотомер",
      "bindings": { "value": "altitude.indicatedFt" },
      "layout": {
        "base": { "x": 0.6, "y": 0.04, "w": 0.25, "h": 0.3 },
        "phone": { "x": 0.51, "y": 0.02, "w": 0.47, "h": 0.16 },
        "tablet-sm": { "x": 0.62, "y": 0.03, "w": 0.24, "h": 0.28 }
      }
    },
    {
      "id": "heading",
      "type": "heading",
      "label": "Курсоуказатель",
      "bindings": {
        "heading": "heading.magneticDeg",
        "bug": "autopilot.headingBugDeg"
      },
      "layout": {
        "base": { "x": 0.02, "y": 0.44, "w": 0.27, "h": 0.3 },
        "phone": { "x": 0.58, "y": 0.19, "w": 0.4, "h": 0.2 },
        "tablet-sm": { "x": 0.02, "y": 0.4, "w": 0.28, "h": 0.27 }
      }
    },
    {
      "id": "tachometer",
      "type": "gauge.radial",
      "label": "Обороты",
      "bindings": { "value": "engine.rpm" },
      "options": {
        "caption": "RPM",
        "min": 0,
        "max": 3500,
        "unit": "RPM",
        "decimals": 0,
        "majorTicks": 7,
        "minorTicks": 4,
        "redline": 2700
      },
      "layout": {
        "base": { "x": 0.31, "y": 0.44, "w": 0.27, "h": 0.3 },
        "phone": { "x": 0.02, "y": 0.41, "w": 0.46, "h": 0.17 },
        "tablet-sm": { "x": 0.32, "y": 0.4, "w": 0.27, "h": 0.27 }
      }
    },
    {
      "id": "vsi",
      "type": "vsi",
      "label": "Вариометр",
      "bindings": { "value": "verticalSpeed.fpm" },
      "options": { "limit": 2000 },
      "layout": {
        "base": { "x": 0.6, "y": 0.4, "w": 0.25, "h": 0.3 },
        "phone": { "x": 0.52, "y": 0.41, "w": 0.46, "h": 0.17 },
        "tablet-sm": { "x": 0.62, "y": 0.36, "w": 0.24, "h": 0.27 }
      }
    },
    {
      "id": "battery-switch",
      "type": "switch.toggle",
      "label": "Аккумулятор",
      "bindings": { "state": "power.batteryMaster" },
      "command": { "key": "power.batteryMaster", "action": "set" },
      "options": { "caption": "BATTERY", "onLabel": "ON", "offLabel": "OFF" },
      "layout": {
        "base": { "x": 0.04, "y": 0.78, "w": 0.22, "h": 0.14 },
        "phone": { "x": 0.02, "y": 0.61, "w": 0.3, "h": 0.085 },
        "tablet-sm": { "x": 0.05, "y": 0.72, "w": 0.22, "h": 0.12 }
      }
    },
    {
      "id": "avionics-switch",
      "type": "switch.toggle",
      "label": "Авионика",
      "bindings": { "state": "power.avionicsMaster" },
      "command": { "key": "power.avionicsMaster", "action": "set" },
      "options": { "caption": "AVIONICS", "onLabel": "ON", "offLabel": "OFF" },
      "layout": {
        "base": { "x": 0.28, "y": 0.78, "w": 0.24, "h": 0.14 },
        "phone": { "x": 0.34, "y": 0.61, "w": 0.3, "h": 0.085 },
        "tablet-sm": { "x": 0.3, "y": 0.72, "w": 0.22, "h": 0.12 }
      }
    },
    {
      "id": "bus-off-lamp",
      "type": "annunciator",
      "label": "Шина обесточена",
      "bindings": { "active": "power.batteryMaster" },
      "options": { "caption": "BUS OFF", "tone": "danger", "invert": true },
      "layout": {
        "base": { "x": 0.55, "y": 0.79, "w": 0.18, "h": 0.09 },
        "phone": { "x": 0.66, "y": 0.61, "w": 0.32, "h": 0.085 },
        "tablet-sm": { "x": 0.56, "y": 0.73, "w": 0.17, "h": 0.08 }
      }
    },
    {
      "id": "flaps",
      "type": "readout",
      "label": "Закрылки",
      "bindings": { "value": "flaps.percent" },
      "options": { "caption": "FLAPS", "unit": "%", "decimals": 0 },
      "layout": {
        "base": { "x": 0.76, "y": 0.78, "w": 0.2, "h": 0.12 },
        "phone": { "x": 0.02, "y": 0.71, "w": 0.3, "h": 0.09 },
        "tablet-sm": { "x": 0.76, "y": 0.72, "w": 0.2, "h": 0.1 }
      }
    }
  ]
}
