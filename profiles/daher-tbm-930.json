{
  "schemaVersion": 1,
  "id": "daher-tbm-930",
  "name": "Daher TBM 930",
  "icao": "TBM9",
  "revision": 1,
  "description": "Турбовинтовой TBM 930: скорость, авиагоризонт, высотомер, курс, вариометр, крутящий момент, ITT, обороты винта, расход и закрылки. Все значения — стандартные SimVar, подходит для Asobo/Working Title TBM.",
  "sim": {
    "match": {
      "title": "*TBM*",
      "atcModel": "*TBM*"
    }
  },
  "panel": {
    "background": "#0b1117",
    "gridSize": 8,
    "footer": "TBM 930 · OPEN DECK"
  },
  "widgets": [
    {
      "id": "attitude",
      "type": "attitude",
      "label": "Авиагоризонт",
      "bindings": { "pitch": "attitude.pitchDeg", "bank": "attitude.bankDeg" },
      "options": { "caption": "ATTITUDE" },
      "layout": {
        "base": { "x": 0.24, "y": 0.04, "w": 0.33, "h": 0.27 },
        "phone": { "x": 0.02, "y": 0.18, "w": 0.55, "h": 0.19 },
        "tablet-sm": { "x": 0.24, "y": 0.03, "w": 0.34, "h": 0.3 }
      }
    },
    {
      "id": "airspeed",
      "type": "gauge.radial",
      "label": "Скорость",
      "bindings": { "value": "speed.iasKt" },
      "options": {
        "caption": "IAS",
        "min": 0,
        "max": 300,
        "unit": "KT",
        "decimals": 0,
        "majorTicks": 6,
        "minorTicks": 5,
        "redline": 250,
        "zones": [
          { "from": 60, "to": 120, "tone": "ok" },
          { "from": 120, "to": 200, "tone": "ok" },
          { "from": 200, "to": 250, "tone": "warn" }
        ]
      },
      "layout": {
        "base": { "x": 0.02, "y": 0.05, "w": 0.2, "h": 0.25 },
        "phone": { "x": 0.02, "y": 0.02, "w": 0.46, "h": 0.15 },
        "tablet-sm": { "x": 0.02, "y": 0.04, "w": 0.2, "h": 0.24 }
      }
    },
    {
      "id": "altimeter",
      "type": "altimeter",
      "label": "Высотомер",
      "bindings": { "value": "altitude.indicatedFt" },
      "layout": {
        "base": { "x": 0.6, "y": 0.05, "w": 0.24, "h": 0.25 },
        "phone": { "x": 0.52, "y": 0.02, "w": 0.46, "h": 0.15 },
        "tablet-sm": { "x": 0.6, "y": 0.04, "w": 0.23, "h": 0.24 }
      }
    },
    {
      "id": "heading",
      "type": "heading",
      "label": "Курсоуказатель",
      "bindings": { "heading": "heading.magneticDeg", "bug": "autopilot.headingBugDeg" },
      "layout": {
        "base": { "x": 0.02, "y": 0.33, "w": 0.25, "h": 0.24 },
        "phone": { "x": 0.59, "y": 0.18, "w": 0.39, "h": 0.19 },
        "tablet-sm": { "x": 0.02, "y": 0.31, "w": 0.25, "h": 0.23 }
      }
    },
    {
      "id": "torque",
      "type": "gauge.radial",
      "label": "Крутящий момент",
      "bindings": { "value": "engine.torquePct" },
      "options": {
        "caption": "TORQUE",
        "min": 0,
        "max": 120,
        "unit": "%",
        "decimals": 0,
        "majorTicks": 6,
        "minorTicks": 4,
        "redline": 100
      },
      "layout": {
        "base": { "x": 0.29, "y": 0.33, "w": 0.23, "h": 0.24 },
        "phone": { "x": 0.02, "y": 0.39, "w": 0.3, "h": 0.12 },
        "tablet-sm": { "x": 0.29, "y": 0.31, "w": 0.23, "h": 0.23 }
      }
    },
    {
      "id": "vsi",
      "type": "vsi",
      "label": "Вариометр",
      "bindings": { "value": "verticalSpeed.fpm" },
      "options": { "limit": 3000 },
      "layout": {
        "base": { "x": 0.55, "y": 0.33, "w": 0.23, "h": 0.24 },
        "phone": { "x": 0.34, "y": 0.39, "w": 0.3, "h": 0.12 },
        "tablet-sm": { "x": 0.55, "y": 0.3, "w": 0.23, "h": 0.23 }
      }
    },
    {
      "id": "prop-rpm",
      "type": "gauge.radial",
      "label": "Обороты винта",
      "bindings": { "value": "engine.propRpm" },
      "options": {
        "caption": "PROP",
        "min": 0,
        "max": 2200,
        "unit": "RPM",
        "decimals": 0,
        "majorTicks": 6,
        "minorTicks": 4,
        "redline": 2000
      },
      "layout": {
        "base": { "x": 0.02, "y": 0.6, "w": 0.24, "h": 0.22 },
        "phone": { "x": 0.02, "y": 0.52, "w": 0.3, "h": 0.12 },
        "tablet-sm": { "x": 0.02, "y": 0.57, "w": 0.23, "h": 0.22 }
      }
    },
    {
      "id": "itt",
      "type": "readout",
      "label": "Температура ITT",
      "bindings": { "value": "engine.ittC" },
      "options": {
        "caption": "ITT",
        "unit": "°C",
        "decimals": 0,
        "alarm": { "above": 850 }
      },
      "layout": {
        "base": { "x": 0.28, "y": 0.6, "w": 0.2, "h": 0.12 },
        "phone": { "x": 0.34, "y": 0.52, "w": 0.3, "h": 0.12 },
        "tablet-sm": { "x": 0.27, "y": 0.57, "w": 0.2, "h": 0.11 }
      }
    },
    {
      "id": "fuel-flow",
      "type": "readout",
      "label": "Расход топлива",
      "bindings": { "value": "engine.fuelFlowGph" },
      "options": { "caption": "FF", "unit": "GPH", "decimals": 1 },
      "layout": {
        "base": { "x": 0.5, "y": 0.6, "w": 0.2, "h": 0.12 },
        "phone": { "x": 0.02, "y": 0.65, "w": 0.3, "h": 0.1 },
        "tablet-sm": { "x": 0.49, "y": 0.57, "w": 0.2, "h": 0.11 }
      }
    },
    {
      "id": "flaps",
      "type": "readout",
      "label": "Закрылки",
      "bindings": { "value": "flaps.percent" },
      "options": { "caption": "FLAPS", "unit": "%", "decimals": 0 },
      "layout": {
        "base": { "x": 0.72, "y": 0.6, "w": 0.24, "h": 0.12 },
        "phone": { "x": 0.34, "y": 0.65, "w": 0.3, "h": 0.1 },
        "tablet-sm": { "x": 0.71, "y": 0.57, "w": 0.22, "h": 0.11 }
      }
    },
    {
      "id": "battery-switch",
      "type": "switch.toggle",
      "label": "Аккумулятор",
      "bindings": { "state": "power.batteryMaster" },
      "command": { "key": "power.batteryMaster", "action": "set" },
      "options": { "caption": "BATTERY", "onLabel": "ON", "offLabel": "OFF" },
      "layout": {
        "base": { "x": 0.28, "y": 0.74, "w": 0.2, "h": 0.12 },
        "phone": { "x": 0.02, "y": 0.77, "w": 0.3, "h": 0.085 },
        "tablet-sm": { "x": 0.27, "y": 0.71, "w": 0.2, "h": 0.12 }
      }
    },
    {
      "id": "avionics-switch",
      "type": "switch.toggle",
      "label": "Авионика",
      "bindings": { "state": "power.avionicsMaster" },
      "command": { "key": "power.avionicsMaster", "action": "set" },
      "options": { "caption": "AVIONICS", "onLabel": "ON", "offLabel": "OFF" },
      "layout": {
        "base": { "x": 0.5, "y": 0.74, "w": 0.22, "h": 0.12 },
        "phone": { "x": 0.34, "y": 0.77, "w": 0.3, "h": 0.085 },
        "tablet-sm": { "x": 0.49, "y": 0.71, "w": 0.22, "h": 0.12 }
      }
    }
  ]
}
